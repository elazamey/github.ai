{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "engineering-control-center",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "engineering-control-center",
      "database_id": "3a8313bd-bf2a-4d6b-882e-0c1ba2115f47",
      "migrations_dir": "migrations"
    }
  ]
}
